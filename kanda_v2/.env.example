# KANDA v2 Configuration
# Copy to .env and fill in your values

# --- LLM ---
KANDA_GROQ_API_KEY=your-groq-api-key
KANDA_GROQ_MODEL=llama-3.3-70b-versatile

# --- Vision ---
KANDA_NVIDIA_API_KEY=your-nvidia-api-key
KANDA_NVIDIA_VLM_MODEL=meta/llama-3.2-11b-vision-instruct

# --- Hardware ---
KANDA_SERIAL_PORT=/dev/ttyUSB0
KANDA_NO_UART=false

# --- Motor ---
KANDA_SPEED_NORMAL=255
KANDA_SPEED_TURN=200
KANDA_SPEED_SLOW=150

# --- TTS ---
KANDA_TTS_ENGINE=gtts
KANDA_GTTS_TLD=com
KANDA_GTTS_SPEED=1.1

# --- Wake Word ---
KANDA_WAKE_WORD_ENABLED=true
KANDA_WAKE_WORD_MODEL=hey_jarvis
KANDA_WAKE_SENSITIVITY=0.1

# --- Telegram ---
KANDA_TELEGRAM_ENABLED=true
KANDA_TELEGRAM_BOT_TOKEN=your-bot-token
KANDA_TELEGRAM_OWNER_ID=0
KANDA_TELEGRAM_ALLOWED_IDS=

# --- Web ---
KANDA_WEB_HOST=0.0.0.0
KANDA_WEB_PORT=8080

# --- Search ---
KANDA_SEARCH_MAX_STEPS=20
KANDA_SEARCH_CONFIDENCE_REQUIRED=2
