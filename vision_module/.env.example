# KANDA Vision Module — Environment Configuration
# Copy this file to .env and fill in your actual keys.
# NEVER commit the .env file with real keys.

# Telegram Bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ENABLED=1
KANDA_TG_OWNER=your_chat_id_here

# TTS Engine: "gtts" (Google, needs internet) or "espeak" (offline)
KANDA_TTS_ENGINE=gtts
KANDA_GTTS_LANG=en
KANDA_GTTS_TLD=co.in

# ESP32 Serial
KANDA_NO_UART=0

# Wake Word: "hey_jarvis" (built-in) or path to custom .onnx
KANDA_WAKE_WORD_MODEL=hey_jarvis

# Groq — primary text model + ASR
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM — primary vision model
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_VLM_MODEL=meta/llama-3.2-11b-vision-instruct
